    "/sim/stop": {
      "post": {
        "tags": [
          "sim"
        ],
        "summary": "Stop",
        "description": "Replay mode: stop the running scenario, including its hold frames, so nothing but the\nreal source (or a probe) publishes for the machine. P1's control API has no stop call\n(sim_control.md), so proxy mode answers 409.",
        "operationId": "stop_sim_stop_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioStopped"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
