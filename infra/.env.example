# Copy to infra/.env for local overrides. Every variable the stack reads is listed here
# (backend/common/config.py is the single reader for edge-api).

# --- time ---
SITE_TZ=Asia/Kolkata            # site timezone for timestamps on the wire (D22)

# --- storage / master data (edge-api) ---
EDGE_DB_PATH=data/edge.db       # SQLite file (relative to backend/ when run from there)
EDGE_SITE_ID=                   # empty = the only site in the DB
EDGE_MACHINE_IDS=               # csv, e.g. EXC001,WL001; empty = every ACTIVE machine of the site
EDGE_SEED_ON_START=false        # true = run tools/seed.py (idempotent) at start-up
CONTRACTS_DIR=                  # empty = <repo>/contracts (rules.yaml, schemas)
DATA_DIR=                       # empty = <repo>/data (seed, catalogue, history)

# --- MQTT ---
MQTT_HOST=localhost             # edge-api, tools/replay.py, tools/record.py (compose: mosquitto)
MQTT_PORT=1883
MQTT_CLIENT_ID=                 # empty = edge-api-<site>-<pid>
MQTT_RECONNECT_S=2              # wait between broker reconnect attempts

# --- auth ---
EDGE_JWT_SECRET=                # REQUIRED unless AUTH_DISABLED=true; long random string
JWT_TTL_S=43200                 # min token lifetime; exp = max(shift planned_end + 2 h, now + JWT_TTL_S)
AUTH_DISABLED=false             # true = every request is admin. P3 dev only; logged loudly

# --- shifts (site-local HH:MM; END <= START = overnight shift) ---
SHIFT_START=07:00
SHIFT_END=17:00

# --- incidents + hazards ---
MEDIA_DIR=data/media            # incident voice notes/photos (edge-local until Phase 9 upload)
MEDIA_MAX_BYTES=10485760        # per uploaded file
HAZARD_EXPIRY_CHECK_S=60        # WORKER_ZONE/SOFT_GROUND auto-expiry job interval

# --- simulator control (contracts/sim_control.md) ---
SIM_MODE=proxy                  # proxy = forward to P1's sim; replay = play fixture JSONL
SIM_CONTROL_URL=                # proxy mode: P1's sim base URL, e.g. http://simulator:9000
SIM_SCENARIOS_DIR=              # replay mode: empty = backend/tests/fixtures/scenarios
SIM_REPLAY_HOLD=true            # replay mode: keep re-sending the last raw frame after a scenario

# --- runtime cadence ---
ENGINE_TICK_S=1                 # engine timer tick (duration-based rules, stale detection)
WS_PING_S=10                    # WebSocket ping interval (contracts/ws.md)
WS_TELEMETRY_MIN_INTERVAL_S=1   # per-client telemetry throttle (<= 1 Hz)
WS_QUEUE_MAX=256                # per-client buffer; overflow closes the socket (client re-snapshots)
SYNC_STATUS_INTERVAL_S=10       # sync_status publish interval

# --- HTTP ---
CORS_ORIGINS=                   # csv of browser origins allowed to call edge-api: P3's dev server
                                # and PWA origin, e.g. http://localhost:5173,http://192.168.8.10:4173
LOG_LEVEL=INFO

# --- tools (tools/ws_probe.py, tools/latency_probe.py) ---
EDGE_BASE_URL=http://localhost:8000
PROBE_BADGE=                    # probe login (e.g. SUP001; --scenario needs admin)
PROBE_PIN=

# --- cloud profile only ---
POSTGRES_USER=companion
POSTGRES_PASSWORD=companion-dev # change for any non-local deployment
POSTGRES_DB=companion
